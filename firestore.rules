rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin';
    }

    match /profiles/{userId} {
      allow create: if isOwner(userId) && request.resource.data.role == 'user';
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role);
      allow delete: if false;
    }

    match /analyses/{analysisId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /saved_analyses/{savedId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /scam_reports/{reportId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /training_candidates/{candidateId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
        && (request.resource.data.reviewStatus == 'pending'
          || (request.resource.data.reviewStatus == 'approved'
            && request.resource.data.autoApproved == true
            && request.resource.data.reviewedLabel == request.resource.data.suggestedLabel));
      allow read: if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}
