# Firebase web configuration. These values are safe to expose to browser clients,
# but Firebase Security Rules must be deployed before production use.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Required only when the frontend is deployed separately (for example, Vercel).
# Use the HTTPS base URL of the deployed FastAPI service, ending in /api/v1.
VITE_API_URL=
