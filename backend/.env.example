# Never commit the service-account JSON file. Set this path in the environment
# before starting the FastAPI API. It allows the automatic worker to read the
# auto-approved Firestore training candidates.
FIREBASE_SERVICE_ACCOUNT_PATH=C:\secure\fraudshield-firebase-service-account.json
MODEL_STORAGE_BUCKET=project-fb8846e5-55f1-4e1b-82e.firebasestorage.app
AUTO_TRAINING_ENABLED=true
AUTO_TRAINING_INTERVAL_SECONDS=300
AUTO_TRAINING_MIN_SAMPLES_PER_KIND=100
AUTO_TRAINING_MIN_F1=0.75
